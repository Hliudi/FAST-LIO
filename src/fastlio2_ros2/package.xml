<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fastlio2_ros2</name>
  <version>1.0.0</version>
  <description>ROS2 (Humble) wrapper around FAST-LIO-NON-ROS core — front lidar/imu -> /odom + odom->base_link TF. Port of dimos cpp/ros1_localizer.cpp.</description>
  <maintainer email="hliudi.ust@gmail.com">rog</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>livox_interfaces</depend>

  <!-- 系统库（cmake find_package） -->
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>nlohmann-json-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
